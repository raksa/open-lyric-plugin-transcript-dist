{
  "name": "open-lyric-plugin-transcript",
  "version": "0.1.5",
  "description": "Audio transcription for the Open Lyric editor — browser-direct ElevenLabs, no server.",
  "license": "MIT",
  "author": "raksa <eng.raksa@gmail.com>",
  "homepage": "https://github.com/raksa/open-lyric/tree/main/packages/open-lyric-plugin-transcript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raksa/open-lyric.git",
    "directory": "packages/open-lyric-plugin-transcript"
  },
  "bugs": {
    "url": "https://github.com/raksa/open-lyric/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "open-lyric",
    "transcript",
    "transcription",
    "speech-to-text",
    "elevenlabs"
  ],
  "peerDependencies": {
    "open-lyric": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
